# systemd: reality-client как служба (Linux).
#
#   sudo install -m 755 target/release/reality-client /usr/local/bin/
#   sudo install -d -m 700 /etc/reality-client
#   sudo cp client.toml server.txt /etc/reality-client/     # и остальные файлы настроек
#   sudo chmod 600 /etc/reality-client/*
#   sudo cp examples/reality-client.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now reality-client
#
# Перечитать настройки без разрыва соединений:  sudo systemctl reload reality-client
# Журнал:  journalctl -u reality-client -f
#
# Служба получает из прав root только CAP_NET_ADMIN — её хватает для TUN
# (интерфейс, маршруты, метка сокетов SO_MARK).

[Unit]
Description=reality-client (VLESS/REALITY)
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/local/bin/reality-client --config /etc/reality-client/client.toml
ExecReload=/bin/kill -HUP $MAINPID
# Снять правила TUN, если прошлый запуск завершился аварийно.
ExecStartPre=-/usr/local/bin/reality-client --tun-cleanup
Restart=on-failure
RestartSec=5

# Права: для TUN — только сеть.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Кеш подписок и fake-IP пишутся рядом с настройками.
ReadWritePaths=/etc/reality-client
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
