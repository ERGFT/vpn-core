# systemd: reality-client как служба (Linux).
#
#   sudo install -m 755 target/release/reality-client /usr/local/bin/
#   sudo install -d -m 700 /etc/reality-client
#   sudo cp config.json /etc/reality-client/     # и файлы, на которые он ссылается
#   sudo chmod 600 /etc/reality-client/*
#   sudo cp examples/reality-client.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now reality-client
#
# Перечитать настройки без разрыва соединений:  sudo systemctl reload reality-client
# Журнал:  journalctl -u reality-client -f
#
# Служба получает из прав root только CAP_NET_ADMIN — её хватает для TUN
# (интерфейс, маршруты, метка сокетов SO_MARK).

[Unit]
Description=reality-client (VLESS/REALITY)
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/local/bin/reality-client --config /etc/reality-client/config.json
ExecReload=/bin/kill -HUP $MAINPID
# Снять правила TUN, если прошлый запуск завершился аварийно. Если
# auto_route держит другой работающий экземпляр, --tun-cleanup ничего не
# трогает и завершается с ошибкой (её гасит «-»), а служба не запустится.
ExecStartPre=-/usr/local/bin/reality-client --tun-cleanup
Restart=on-failure
RestartSec=5

# Права: для TUN — только сеть.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Кеш подписок и fake-IP пишутся рядом с настройками.
ReadWritePaths=/etc/reality-client
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Сокеты: IPv4/IPv6, Unix (блокировка auto_route), Netlink (маршруты).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# Для TUN нужен /dev/net/tun; остальные устройства закрыты
# (PrivateDevices=yes не подходит — оно убирает и /dev/net/tun).
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw
ProtectKernelModules=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
MemoryDenyWriteExecute=yes
# Проверка: systemd-analyze security reality-client

[Install]
WantedBy=multi-user.target
