+    #[test]
+    fn test_established_rejects_data_beyond_advertised_window() {
+        let mut s = socket_established_with_buffer_sizes(64, 63);
+        s.remote_win_scale = Some(0);
+        s.remote_win_shift = 2;
+        s.remote_last_win = 15;
+        send!(
