+                seq_number: LOCAL_SEQ + 1,
+                ack_number: Some(REMOTE_SEQ + 1 + 60),
+                window_len: 0,
+                ..RECV_TEMPL
+            }]
+        );
+        // Объявлено окно 0, свободно 3 байта: байт за окном отвергается.
+        send!(
+            s,
+            TcpRepr {
+                seq_number: REMOTE_SEQ + 1 + 60,
+                ack_number: Some(LOCAL_SEQ + 1),
+                payload: &[0; 1],
+                ..SEND_TEMPL
+            },
+            Some(TcpRepr {
