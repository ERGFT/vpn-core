+/// Обёртка `Box<dyn ActiveKeyExchange>` вокруг `RealityClientHook`: наш
+/// единственный "настоящий" эфемерный секрет (гибрид X25519+ML-KEM-768)
+/// для этого рукопожатия и он же — key_share, который пойдёт в
+/// исходящий ClientHello. `complete()` вызывается rustls ровно один раз,
+/// когда придёт ServerHello с настоящим key_share сервера — это обычное
+/// завершение TLS1.3-обмена ключами, ничего не знает про
+/// REALITY-аутентификацию (та уже была посчитана раньше, в
+/// `emit_client_hello_for_retry`, через `seal_session_id`, с тем же
+/// секретом внутри хука).
+///
+/// Группа жёстко зашита в `X25519MLKEM768`: текущие серверы Xray-core
+/// REALITY (26.9.8+) требуют именно её — голый X25519 они принимают
+/// молча неверно (REALITY-аутентификация проваливается без явной
+/// ошибки), см. `PLAN.md`, Этап 5. `key_share_bytes` кэшируется один раз
+/// в `new()` (1216 байт: `hook.client_hybrid_key_share()` уже отдаёт их
+/// в нужном порядке — ML-KEM768 encapsulation key, затем X25519), чтобы
+/// `pub_key()` могло вернуть `&[u8]` без пересчёта на каждый вызов.
+struct RealityKeyExchange {
+    hook: Arc<dyn RealityClientHook>,
+    key_share_bytes: Vec<u8>,
+}
+
+impl RealityKeyExchange {
+    fn new(hook: Arc<dyn RealityClientHook>) -> Self {
+        let key_share_bytes = hook.client_hybrid_key_share();
+        Self {
+            hook,
+            key_share_bytes,
+        }
+    }
+}
+
+impl core::fmt::Debug for RealityKeyExchange {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        f.debug_struct("RealityKeyExchange").finish_non_exhaustive()
+    }
+}
+
+impl ActiveKeyExchange for RealityKeyExchange {
+    fn complete(self: Box<Self>, peer_key_share: &[u8]) -> Result<SharedSecret, Error> {
+        // `peer_key_share` — полный key_share сервера для X25519MLKEM768
+        // (1120 байт: ML-KEM768 ciphertext + X25519-ключ сервера). Хук
+        // сам разбирает эти байты и комбинирует секреты в нужном порядке
+        // (mlkem || ecdh) — см. доку `RealityClientHook::complete_real_ecdh`
+        // и `reality-core::reality::hook::RealityHook`.
+        let shared = self.hook.complete_real_ecdh(peer_key_share)?;
+        // Буфер переходит в SharedSecret целиком (он стирает его при
+        // удалении) — без лишней копии секрета, которую никто не обнулит.
+        Ok(SharedSecret::from(shared))
+    }
+
+    fn pub_key(&self) -> &[u8] {
+        &self.key_share_bytes
+    }
+
+    fn group(&self) -> NamedGroup {
+        NamedGroup::X25519MLKEM768
+    }
+
+    // reality-core: X25519-часть гибридной доли уходит ещё и отдельной
+    // записью key_share (как у Chrome: `[GREASE, X25519MLKEM768, X25519]`).
+    // Нужно для сайтов-приманок без ML-KEM: они выбирают X25519, и без
+    // этой записи рукопожатие не складывалось вовсе (сервер REALITY
+    // отвечал "target sent incorrect server hello").
+    fn hybrid_component(&self) -> Option<(NamedGroup, &[u8])> {
+        let n = self.key_share_bytes.len();
+        (n >= 32).then(|| (NamedGroup::X25519, &self.key_share_bytes[n - 32..]))
+    }
+
+    fn complete_hybrid_component(
+        self: Box<Self>,
+        peer_pub_key: &[u8],
+    ) -> Result<SharedSecret, Error> {
+        let shared = self.hook.complete_x25519(peer_pub_key)?;
+        Ok(SharedSecret::from(shared))
+    }
+}
