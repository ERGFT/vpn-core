+/// REALITY (см. Xray-core/XTLS): точка расширения, позволяющая внешнему
+/// крейту (в нашем случае — `reality-core`) взять под контроль два места
+/// в исходящем ClientHello, которые обычный rustls не даёт настроить —
+/// (а) X25519 key_share (тот же эфемерный секрет нужен дважды: для
+/// REALITY-аутентификации ниже и позже для настоящего TLS1.3 ECDH с
+/// сервером) и (б) содержимое поля `legacy_session_id`. Без установленного
+/// `ClientConfig::reality` ничего не меняется — обычный путь как раньше.
+///
+/// Это не универсальный API поверх rustls, а точечный хук под конкретный
+/// протокол: сознательно минимальная поверхность (3 метода), а не попытка
+/// сделать TLS-стек программируемым в целом.
+///
+/// # Обновление: гибридный X25519MLKEM768
+/// Текущие серверы Xray-core REALITY (26.9.8+) требуют, чтобы key_share
+/// в ClientHello был не голым X25519 (32 байта), а гибридной группой
+/// `X25519MLKEM768` (rustls уже знает этот codepoint нативно, `0x11ec`,
+/// см. `msgs::enums::NamedGroup`) — конкатенация ML-KEM-768
+/// encapsulation key (1184 байта) и X25519-ключа (32 байта) = 1216 байт
+/// (`draft-ietf-tls-ecdhe-mlkem-02` §4.1: для X25519MLKEM768 именно
+/// ML-KEM-часть идёт первой). Поэтому `client_public_key()` заменён на
+/// `client_hybrid_key_share()`, а `complete_real_ecdh` теперь получает
+/// ПОЛНЫЙ key_share сервера для этой группы (1120 байт: ML-KEM768
+/// ciphertext + X25519-ключ сервера), а не голые 32 байта.
+/// REALITY-аутентификация (AuthKey) этого не касается — она как была,
+/// так и осталась чистым X25519 ECDH с REALITY-сервером (см.
+/// `reality-core::reality::hook::RealityHook`); гибрид нужен только для
+/// НАСТОЯЩЕГО TLS1.3-рукопожатия, которое видит сервер.
+pub trait RealityClientHook: fmt::Debug + Send + Sync {
+    /// Гибридный key_share этого рукопожатия для группы
+    /// `NamedGroup::X25519MLKEM768`: ML-KEM-768 encapsulation key (1184
+    /// байта) || X25519 публичный ключ (32 байта) = 1216 байт.
+    fn client_hybrid_key_share(&self) -> Vec<u8>;
+
+    /// Запечатать SessionId AEAD'ом. `client_hello_random` — точные 32
+    /// байта поля `random`, которые реально уйдут в этом ClientHello.
+    /// `aad` — точные байты всего Handshake-сообщения ClientHello (тип +
+    /// длина(u24) + тело), в том виде, в котором оно уйдёт на сервер, но
+    /// с полем SessionId, временно обнулённым (32 нулевых байта) — той
+    /// самой позицией, куда затем встанет результат этой функции. Байт-в-
+    /// байт повторяет `aead.Seal(hello.SessionId[:0], hello.Random[20:],
+    /// hello.SessionId[:16], hello.Raw)` из `reality.go` в Xray-core.
+    fn seal_session_id(&self, client_hello_random: &[u8; 32], aad: &[u8]) -> [u8; 32];
+
+    /// Завершить НАСТОЯЩИЙ TLS1.3-обмен ключами с сервером из
+    /// ServerHello. `peer_key_share` — ПОЛНЫЙ key_share сервера для
+    /// группы X25519MLKEM768: ML-KEM-768 ciphertext (1088 байт) || X25519
+    /// публичный ключ сервера (32 байта) = 1120 байт. Реализация обязана
+    /// вернуть `mlkem_shared_secret(32) || ecdh_shared_secret(32)` = 64
+    /// байта, в этом порядке — именно так комбинирует секреты сам Go
+    /// (`crypto/tls`, `hybridKeyExchange.clientSharedSecret`, ветка
+    /// `X25519MLKEM768`), и именно этот порядок ожидает остальной TLS1.3
+    /// key schedule. X25519-часть использует тот же эфемерный секрет,
+    /// чья ML-KEM+X25519-пара была отдана в `client_hybrid_key_share()`
+    /// — поэтому не `x25519_dalek::EphemeralSecret` (запрещает повторное
+    /// использование), а `StaticSecret`.
+    fn complete_real_ecdh(&self, peer_key_share: &[u8]) -> Result<Vec<u8>, Error>;
+
+    /// Получен ServerHello: `raw` — всё Handshake-сообщение (тип + длина
+    /// + тело), как `ServerHello.Raw` в Go. Нужен клиенту REALITY для
+    /// проверки подписи ML-DSA-65 (она покрывает ClientHello и
+    /// ServerHello). По умолчанию ничего не делает.
+    fn server_hello_received(&self, _raw: &[u8]) {}
+
+    /// Сервер выбрал классическую группу X25519 вместо гибридной
+    /// (сайт-приманка без поддержки ML-KEM): завершить обычный X25519 ECDH
+    /// тем же эфемерным ключом, что лежит в X25519-части гибридной доли.
+    /// Должен вернуть 32-байтный общий секрет. По умолчанию — ошибка.
+    fn complete_x25519(&self, _peer_key_share: &[u8]) -> Result<Vec<u8>, Error> {
+        Err(Error::General("REALITY: сервер выбрал X25519, хук этого не умеет".into()))
+    }
+}
